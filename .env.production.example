POSTGRES_PASSWORD=replace-with-strong-password

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://clarklab:replace-with-strong-password@postgres:5432/clarklab
LATEST_AGENT_VERSION=0.1.3

JWT_SECRET=replace-with-openssl-rand-hex-32
PASSWORD_RESET_TOKEN_SECRET=replace-with-openssl-rand-hex-32
INTEGRATION_ENCRYPTION_KEY=replace-with-different-openssl-rand-hex-32
SIGNUP_ACCESS_CODE=replace-with-strong-signup-code

CLARKLAB_SERVER_URL=https://api.yourdomain.com
CLARKLAB_AGENT_INSTALL_URL=https://api.yourdomain.com/agent/install.sh

CORS_ORIGIN=https://app.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REGISTRATION_TOKEN_TTL_MINUTES=1440

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://app.yourdomain.com/dashboard/settings

CLARKLAB_SERVICE_BASE_DOMAIN=yourdomain.com
CLARKLAB_RESERVED_SUBDOMAINS=api,app,www
CLARKLAB_EDGE_PROXY_CONFIG_PATH=/data/caddy/Caddyfile
CLARKLAB_EDGE_PROXY_ADMIN_URL=http://caddy:2019
CLARKLAB_HOST_REPO_PATH=/host/clarklab
CLARKLAB_DOCKER_COMPOSE_FILE=docker-compose.prod.yml
CLARKLAB_APP_BRAND_NAME=ClarkLab
CLARKLAB_APP_DOMAIN=yourdomain.com

VITE_API_URL=https://api.yourdomain.com
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_OAUTH_REDIRECT_URI=https://app.yourdomain.com/dashboard/settings
VITE_CLARKLAB_SERVER_URL=https://api.yourdomain.com
VITE_CLARKLAB_AGENT_INSTALL_URL=https://api.yourdomain.com/agent/install.sh
VITE_CLARKLAB_SERVICE_BASE_DOMAIN=yourdomain.com
VITE_APP_BRAND_NAME=ClarkLab
VITE_APP_DOMAIN=yourdomain.com
VITE_REGISTRATION_TOKEN_TTL_MINUTES=1440
VITE_LATEST_AGENT_VERSION=0.1.3
